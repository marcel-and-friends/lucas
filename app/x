#!/usr/bin/env nu

const root = path self .

def main [] {
  main run desktop
}

def "main run" [
  target: string
] {
  match (target | str downcase) {
    "desktop" => (npx ionic serve --prod)
    "android" => (npx ionic capacitor run android --livereload --external)
  }
}

def "main build" [
  target: string
] {
  match (target | str downcase) {
    "desktop" => {
      npx tsc
      npx vite build
    }
    "android" => {
      npx ionic capacitor build android --prod --no-open
      npx cap build android
      ^$"($env.ANDROID_SDK_ROOT)/build-tools/36.0.0/zipalign" -P 16 -f -v 4 $"($root)/android/app/build/outputs/apk/release/app-release-signed.apk" $"($root)/android/app/build/outputs/apk/release/zipalign-app-release-signed.apk
"    }
  }
}
